                                                    <small class="text-muted d-block">Full calculation with all fields</small>
                                                </label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" name="calculationMode" id="gradeWeightMode" value="gradeweight">
